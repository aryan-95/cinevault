# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Local dev default: sqlite:///cinevault.db
# Production example: postgresql+psycopg2://cinevault:cinevault@db:5432/cinevault
DATABASE_URL=sqlite:///cinevault.db

# Default admin account created by scripts/seed.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# File storage
UPLOAD_FOLDER=media
STORAGE_BACKEND=local
# S3_BUCKET_NAME=
# CLOUDFRONT_URL=

# Cookies (set to true when serving over HTTPS in production)
SESSION_COOKIE_SECURE=false
JWT_COOKIE_SECURE=false

# Video processing
ENABLE_HLS=false
FFMPEG_BIN=ffmpeg

# Misc
ITEMS_PER_PAGE=20
LOG_LEVEL=INFO
